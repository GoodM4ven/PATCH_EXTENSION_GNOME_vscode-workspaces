{
    "name": "vscodium-workspaces",
    "version": "1.0.0",
    "description": "A VSC workspace management and quick switching tool-set for GNOME.",
    "type": "module",
    "private": true,
    "author": "GoodM4ven",
    "license": "GPL-3.0-or-later",
    "sideEffects": false,
    "keywords": [
        "vsc",
        "vscode",
        "vscodium",
        "linux",
        "gnome",
        "gnome-extension",
        "vscode-workspace",
        "management",
        "switching",
        "traversal"
    ],
    "scripts": {
        "format": "prettier --check .",
        "format:fix": "prettier --write --cache . && eslint --fix .",
        "update-deps": "npm update",
        "typecheck": "tsc --noEmit"
    },
    "devDependencies": {
        "typescript": "^5.5.2",
        "@types/node": "^20.14.2",
        "esbuild": "^0.21.1",
        "globals": "^15.2.0",
        "tsm": "^2.3.0",
        "eslint": "^8.56.0",
        "prettier": "^3.2.5",
        "@eslint/js": "^9.5.0",
        "eslint-plugin-jsdoc": "^48.2.15",
        "eslint-config-prettier": "^9.1.0",
        "eslint-plugin-prettier": "^5.1.3",
        "typescript-eslint": "^7.14.1",
        "@typescript-eslint/eslint-plugin": "^7.7.1",
        "uvu": "^0.5.6"
    },
    "dependencies": {
        "@girs/gjs": "^3.3.0",
        "@girs/gnome-shell": "^50.0.0"
    }
}
